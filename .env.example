# Copy to .env (make setup does this). Never commit .env.
ANTHROPIC_API_KEY=
JEV_API_KEY=
LEO_MODEL_EXTRACT=claude-haiku-5-5
LEO_MODEL_DRAFT=claude-haiku-5-5
